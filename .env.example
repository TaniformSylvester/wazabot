# WazaBolt — copy to .env.local and fill in. Never commit real values.

# Public site URL (used for metadata / absolute links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase — Project Settings → API. The anon key is public; RLS protects the data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only, bypasses RLS: webhook processing and private media storage/signed URLs.
# Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic — server-side only, never exposed to the browser. Not used until AI replies ship.
ANTHROPIC_API_KEY=

# WhatsApp Business Platform / Cloud API — server-side only. Not used until Stage 2.
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
# Verifies X-Hub-Signature-256 on incoming webhooks (Meta app → Settings → Basic → App secret).
WHATSAPP_APP_SECRET=
# Graph API version used for media downloads (default v21.0).
WHATSAPP_GRAPH_API_VERSION=

# Speech-to-text for voice notes — provider not chosen yet (see README → Multimodal messages).

# Payments — provider abstracted, not integrated yet (Phase 8)
PAYMENT_PROVIDER_API_KEY=
