# WazaBolt — copy to .env.local and fill in. Never commit real values.

# Public site URL (used for metadata / absolute links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase — Project Settings → API. The anon key is public; RLS protects the data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only, bypasses RLS: WhatsApp webhook processing, token storage and private media/signed URLs.
# Required for WhatsApp (Stage 2).
# Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic (Claude) — AI replies on WhatsApp. Server-side only, never NEXT_PUBLIC_.
# Without a key the assistant stays off and the team answers.
ANTHROPIC_API_KEY=
# Optional: model (default claude-opus-5-5), effort low|medium|high|xhigh|max (default low — chat
# replies are short; raise if answers need more care), wait before answering a burst of messages (ms).
AI_MODEL=
AI_EFFORT=
AI_DEBOUNCE_MS=

# WhatsApp Business Platform / Cloud API — server-side only, never NEXT_PUBLIC_.
# One Meta app for the whole platform; each business connects its own number
# from Dashboard → WhatsApp (Phone Number ID, WABA ID, access token).
# Meta app → Settings → Basic → App secret (verifies X-Hub-Signature-256 on webhooks).
WHATSAPP_APP_SECRET=
# Any long random string; paste the same value in Meta app → WhatsApp → Configuration → Verify token.
WHATSAPP_VERIFY_TOKEN=
# 32 random bytes, base64 (openssl rand -base64 32). Encrypts stored access tokens. Don't change it
# after businesses connect (they would have to reconnect).
WHATSAPP_TOKEN_ENCRYPTION_KEY=
# Graph API version (default v23.0).
WHATSAPP_GRAPH_API_VERSION=

# Speech-to-text for voice notes — provider not chosen yet (see README → Multimodal messages).

# Payments — provider abstracted, not integrated yet (Phase 8)
PAYMENT_PROVIDER_API_KEY=
