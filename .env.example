# WazaBolt — copy to .env.local and fill in. Never commit real values.

# Public site URL (used for metadata / absolute links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (Phase 2+)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic — server-side only, never exposed to the browser (Phase 6)
ANTHROPIC_API_KEY=

# WhatsApp Business Platform / Cloud API (Phase 5)
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=

# Payments — provider abstracted, not integrated yet (Phase 8)
PAYMENT_PROVIDER_API_KEY=
