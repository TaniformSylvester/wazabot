{
  "name": "wazabolt",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test:e2e": "node tests/e2e/auth.e2e.mjs",
    "test:e2e:dashboard": "node tests/e2e/dashboard.e2e.mjs",
    "test:e2e:whatsapp": "node tests/e2e/whatsapp.e2e.mjs",
    "test:e2e:operations": "node tests/e2e/operations.e2e.mjs",
    "test:e2e:pos": "node tests/e2e/pos.e2e.mjs",
    "test:e2e:plans": "node tests/e2e/plans.e2e.mjs",
    "test:e2e:customers-orders": "node tests/e2e/customers-orders.e2e.mjs",
    "test:e2e:mobile": "node tests/e2e/mobile.e2e.mjs",
    "test:e2e:appointments": "node tests/e2e/appointments.e2e.mjs",
    "test:e2e:notifications": "node tests/e2e/notifications.e2e.mjs",
    "test:e2e:broadcasts": "node tests/e2e/broadcasts.e2e.mjs",
    "test:e2e:ai": "node tests/e2e/ai.e2e.mjs",
    "test:db": "psql \"$DATABASE_URL\" -v ON_ERROR_STOP=1 -f supabase/tests/tenant_isolation.sql -f supabase/tests/multilingual.sql -f supabase/tests/multimodal.sql -f supabase/tests/saas_foundation.sql -f supabase/tests/whatsapp_integration.sql -f supabase/tests/ai_replies.sql -f supabase/tests/business_operations.sql -f supabase/tests/appointments.sql -f supabase/tests/notifications.sql -f supabase/tests/broadcasts.sql -f supabase/tests/cost_tracking.sql -f supabase/tests/margin_protection.sql -f supabase/tests/pos_inventory.sql -f supabase/tests/plan_limits.sql -f supabase/tests/customer_orders.sql",
    "test": "vitest run",
    "simulate": "vitest run tests/unit/simulation.test.ts",
    "db:types": "npx -y supabase@2 gen types typescript --db-url \"$DATABASE_URL\" --schema public > types/supabase.ts && npx -y oxfmt types/supabase.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "@hookform/resolvers": "^5.9.1",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.48.0",
    "next": "16.3.6",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.89.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "playwright": "^1.56.1",
    "sharp": "^0.35.5",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5",
    "vitest": "^3.2.7"
  }
